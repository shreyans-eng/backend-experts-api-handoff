# Copy to .env and fill in development values.
# Inside Docker Compose, Mongo/Redis MUST use service names (not localhost).

NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://mongo:27017/coinzy
REDIS_URL=redis://redis:6379

# --- Shared with FE for local auth testing (ask backend for current dev values) ---
USER_JWT_SHARED_SECRET=change-me
EXPERT_JWT_SECRET=change-me
EXPERT_JWT_EXPIRES_IN=7d
ADMIN_API_KEY=change-me

FIRST_ACCEPTANCE_WINDOW_HOURS=24
REQUEST_TTL_HOURS=48
REQUEST_DEADLINE_HOURS=72
ALLOWED_COUNTRIES=US|CA|GB|AU|NZ|IN|DE
FIRST_POOL_SIZE=4
SECOND_POOL_SIZE=4
DEFAULT_SPEED_PENALTY=0
ALLOCATION_SCORE_BASE=100
ALLOCATION_WORKLOAD_WEIGHT=1
ALLOCATION_SPEED_WEIGHT=1
# No surrounding quotes — Docker Compose env_file passes quotes into the value.
ALLOCATION_WORKLOAD_PENALTY_SLABS=[{"lt":1,"penalty":0},{"lt":2,"penalty":-5},{"lt":3,"penalty":-10},{"lt":4,"penalty":-20},{"penalty":-999999}]
ALLOCATION_SPEED_PENALTY_SLABS=[{"lt":12,"penalty":0},{"lt":24,"penalty":-2},{"lt":48,"penalty":-5},{"penalty":-10}]
MAX_ACTIVE_COMMITTED_REQUESTS=4
INTERNAL_EXPERT_EMAIL=internal@example.com
INTERNAL_EXPERT_NAME=Internal Expert
INTERNAL_EXPERT_PASSWORD=change-me

# Optional for local UI work — leave empty unless testing that feature.
APPLE_BUNDLE_ID=
APPLE_PRODUCT_ID=
APPLE_SHARED_SECRET=
APPLE_USE_SANDBOX=false

GOOGLE_PACKAGE_NAME=
GOOGLE_PRODUCT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
MEDIA_PUBLIC_BASE_URL=
UPLOAD_MAX_FILES=7
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_VIDEO_BYTES=104857600

AGENDA_PROCESS_EVERY=30 seconds
NOTIFICATION_LOG_TTL_DAYS=14
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
PAYMENTS_RATE_LIMIT_MAX=30
ADMIN_RATE_LIMIT_MAX=60

LOG_FILE_PATH=
LOG_FILE_LEVEL=error

ENABLE_GRAFANA_LOGS=no
GRAFANA_APP_LABEL=coinzy-experts-api
GRAFANA_HOST=
GRAFANA_USER=
GRAFANA_PASS=
